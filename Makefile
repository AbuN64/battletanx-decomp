9dc5c/source.o && '$(OBJCOPY)' -O binary -j .data --set-section-flags .data=alloc,load,contents build/us/src/data.unresolved.80126768/a18b3149dc5c/linked.elf build/us/src/data.unresolved.80126768/a18b3149dc5c/data.bin && test "$$(wc -c < build/us/src/data.unresolved.80126768/a18b3149dc5c/data.bin)" -eq 48040
