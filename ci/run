#!/bin/sh
# Generated file. The one CI entry point: sh ci/run STAGE. The GitHub and GitLab files only call it.
#   check        the committed tree: progress reports and the files the site reads
#   audit        the source rules a change adds (CI_BASE: the revision it is compared with)
set -eu
cd "$(dirname "$0")/.."
WHEEL=https://github.com/AbuN64/cake-unbake-64/releases/download/v0.4.2/unbake-0.4.2-py3-none-any.whl
VERSIONS="us"

base() {
    b=${CI_BASE:-}
    case "$b" in ""|*0000000000000000000000000000000000000000) b=4b825dc642cb6eb9a060e54bf8d69288fbee4904 ;; esac
    git cat-file -e "$b^{tree}" 2>/dev/null || b=HEAD
    echo "$b"
}

case "${1:-}" in
check)
    make check CHECK=tree
    ;;
audit)
    pip install "$WHEEL"
    unbake audit --against "$(base)"
    ;;
*)
    echo "usage: sh ci/run check | audit" >&2
    exit 2
    ;;
esac
