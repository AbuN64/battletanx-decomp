#!/bin/sh
# Generated by unbake. The one CI entry point: sh ci/run STAGE. The GitHub and GitLab files only call it.
#   check        the committed tree: progress reports and the files the site reads
#   audit        the source rules a change adds (CI_BASE: the revision it is compared with)
#   board NAME   publish the progress reports to one external board (REPO owner/name, COMMIT sha)
set -eu
cd "$(dirname "$0")/.."
WHEEL=https://github.com/AbuN64/cake-unbake-64/releases/download/v0.4.0/unbake-0.4.0-py3-none-any.whl
VERSIONS="us"

base() {
    b=${CI_BASE:-}
    case "$b" in ""|*0000000000000000000000000000000000000000) b=4b825dc642cb6eb9a060e54bf8d69288fbee4904 ;; esac
    git cat-file -e "$b^{tree}" 2>/dev/null || b=HEAD
    echo "$b"
}

case "${1:-}" in
check)
    make check CHECK=tree
    ;;
audit)
    pip install "$WHEEL"
    unbake audit --against "$(base)"
    ;;
board)
    name=${2:-}
    if [ -f ".boards/$name" ]; then
        echo "$name: progress.json is unchanged since this board last published"
        exit 0
    fi
    case "$name" in
    bytematch)
        if [ -z "${BYTEMATCH_TOKEN:-}" ]; then
            echo "bytematch: the BYTEMATCH_TOKEN secret is not set, nothing is published"
            exit 0
        fi
        for v in $VERSIONS; do
            gzip -c "versions/$v/report.json" |
                curl -fsS -X POST -H "Authorization: Bearer $BYTEMATCH_TOKEN" -H "Content-Encoding: gzip" \
                --data-binary @- "https://bytematch.dev/api/v1/projects/$REPO/reports?version=$v&commit=$COMMIT"
            echo
        done
        ;;
    recomp)
        for v in $VERSIONS; do test -s "versions/$v/report.json"; done
        ;;
    *)
        echo "unknown board: $name" >&2
        exit 2
        ;;
    esac
    mkdir -p .boards
    : >".boards/$name"
    ;;
*)
    echo "usage: sh ci/run check | audit | board NAME" >&2
    exit 2
    ;;
esac
